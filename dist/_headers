# Cloudflare keš. CSS, JS, slike i video se uvek traže sa ?v= oznakom
# (vidi README, "Keš"), pa smeju da se čuvaju godinu dana: nova verzija
# dobija novu oznaku. Logotipi i ikonice nemaju oznaku, pa samo jedan dan.
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=86400
/*.png
  Cache-Control: public, max-age=86400
/*.ico
  Cache-Control: public, max-age=86400
