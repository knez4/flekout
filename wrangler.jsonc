// Cloudflare (Workers + statični fajlovi). Deploy ide sam posle svakog
// push-a na main ("npx wrangler deploy" u Cloudflare podešavanjima).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flekout",
  "compatibility_date": "2026-10-12",
  "main": "worker.js",
  "observability": { "enabled": true },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // Worker ide pre statičnih fajlova: www preusmerava na glavni domen,
    // a video šalje u delovima (vidi worker.js).
    "run_worker_first": true
  }
}
